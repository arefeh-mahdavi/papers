      <pdf:Keywords>FPGA, RISC-V, Control and Status Registers (CSR), decoding, multiplexing, performance optimization, digital design</pdf:Keywords>
      <pdf:PDFVersion>2.0</pdf:PDFVersion>
      <dc:format>application/pdf</dc:format>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="en">High-Performance RISC-V CSR Access in FPGAs: Optimized Microarchitecture for Efficient Decoding and Multiplexing</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="en">-  Hardware  -&gt;  Reconfigurable logic and FPGAs;Datapath optimization;Logic synthesis;Technology-mapping;Physical design (EDA);Placement;Wire routing;Partitioning and floorplanning;Physical synthesis;Best practices for EDA;Simulation and emulation;Assertion checking;Static timing analysis;-  Computer systems organization  -&gt;  Reduced instruction set computing;</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Association for Computing Machinery</rdf:li>
        </rdf:Bag>
